---
interface Props {
  href: string;
  variant?: "primary" | "secondary" | "outline";
  class?: string;
  /** Nom d'événement Umami (data-umami-event) */
  umamiEvent?: string;
  /** Propriétés Umami (data-umami-event-*) */
  umamiProps?: Record<string, string>;
}

const {
  href,
  variant = "primary",
  class: className = "",
  umamiEvent,
  umamiProps,
} = Astro.props;
const isExternal = href.startsWith("http");

const umamiDataAttrs: Record<string, string> = {};
if (umamiEvent) {
  umamiDataAttrs["data-umami-event"] = umamiEvent;
  if (umamiProps) {
    for (const [key, value] of Object.entries(umamiProps)) {
      if (value) umamiDataAttrs[`data-umami-event-${key}`] = value;
    }
  }
}
---

<a
  {href}
  class:list={["button", variant, className]}
  {...isExternal ? { target: "_blank", rel: "noopener noreferrer" } : {}}
  {...umamiDataAttrs}
>
  <slot />
</a>

<style>
  .button {
    display: inline-block;
    padding: 0.8em 1.8em;
    border-radius: var(--radius-full);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: var(--text-base);
    text-decoration: none;
    text-align: center;
    transition:
      background var(--transition),
      color var(--transition),
      transform var(--transition);
  }

  .button:hover {
    transform: translateY(-2px);
  }

  .primary {
    background: var(--color-button);
    color: var(--color-button-text);
  }

  .primary:hover {
    background: var(--color-button-hover);
    color: var(--color-button-text);
  }

  .secondary {
    background: var(--color-secondary-dark);
    color: #fff;
  }

  .secondary:hover {
    background: var(--color-secondary-stronger);
    color: #fff;
  }

  .outline {
    background: transparent;
    color: var(--color-primary-dark);
    border: 2px solid var(--color-primary);
  }

  .outline:hover {
    background: var(--color-button);
    color: var(--color-button-text);
  }
</style>
