---
/**
 * Section « À savoir avant de consulter » : liste → cartes avec titres et icônes.
 */
import { Ban, HandCoins, HeartHandshake, UsersRound } from "@lucide/astro";

const icons = [
  { key: "ban", Icon: Ban },
  { key: "mutuelle", Icon: HandCoins },
  { key: "ados", Icon: UsersRound },
  { key: "inclusif", Icon: HeartHandshake },
] as const;
---

<div id="infos-notes-icons" hidden aria-hidden="true">
  {
    icons.map(({ key, Icon }) => (
      <span data-infos-note-icon={key}>
        <Icon size={22} stroke-width={1.75} aria-hidden="true" />
      </span>
    ))
  }
</div>

<script>
  function splitLabeledHtml(html: string): { label: string | null; body: string } {
    const wrap = document.createElement("div");
    wrap.innerHTML = html.trim();

    const context =
      wrap.childElementCount === 1 && wrap.firstElementChild?.tagName === "P"
        ? wrap.firstElementChild
        : wrap;

    const strong = [...context.childNodes].find(
      (node): node is HTMLElement =>
        node.nodeType === Node.ELEMENT_NODE && (node as HTMLElement).tagName === "STRONG"
    );
    if (!strong) return { label: null, body: html };

    const raw = strong.textContent?.trim() ?? "";
    if (!/[—–-]/.test(raw)) return { label: null, body: html };

    const label = raw.replace(/\s*[—–-]\s*$/, "").trim();
    strong.remove();
    const body = context.innerHTML.replace(/^\s*(?:<br\s*\/?>)?\s*/, "");
    return { label: label || null, body };
  }

  function buildInfosNotes(prose: HTMLElement) {
    const heading = prose.querySelector<HTMLElement>(
      'h2[id^="à-savoir-avant"], h2[id^="a-savoir-avant"], h2[id^="what-to-know"]'
    );
    if (!heading || heading.dataset.infosNotesReady === "true") return;

    const list = heading.nextElementSibling;
    if (!list || list.tagName !== "UL") return;

    const items = [...list.querySelectorAll(":scope > li")];
    if (items.length < 2) return;

    const iconRoot = document.getElementById("infos-notes-icons");
    const iconSlots = iconRoot
      ? [...iconRoot.querySelectorAll<HTMLElement>("[data-infos-note-icon]")]
      : [];

    const section = document.createElement("section");
    section.className = "infos-notes";
    section.setAttribute("aria-labelledby", heading.id);

    const grid = document.createElement("ul");
    grid.className = "infos-notes-grid";

    items.forEach((item, index) => {
      const card = document.createElement("li");
      card.className = "infos-notes-card";

      const iconWrap = document.createElement("span");
      iconWrap.className = "infos-notes-icon";
      iconWrap.setAttribute("aria-hidden", "true");

      const source = iconSlots[index] ?? iconSlots[iconSlots.length - 1];
      const svg = source?.querySelector("svg")?.cloneNode(true);
      if (svg) iconWrap.append(svg);

      const { label, body } = splitLabeledHtml(item.innerHTML);
      const bodyEl = document.createElement("div");
      bodyEl.className = "infos-notes-body";

      if (label) {
        const title = document.createElement("p");
        title.className = "infos-notes-title";
        title.textContent = label;
        bodyEl.append(title);
      }

      const text = document.createElement("div");
      text.className = "infos-notes-text";
      text.innerHTML = body;
      bodyEl.append(text);

      card.append(iconWrap, bodyEl);
      grid.append(card);
    });

    heading.before(section);
    section.append(heading, grid);
    list.remove();
    heading.dataset.infosNotesReady = "true";
  }

  function buildInfosClosing(prose: HTMLElement) {
    if (prose.querySelector(".infos-closing")) return;

    const notes = prose.querySelector(".infos-notes");
    if (!notes) return;

    const nodes: Element[] = [];
    let next = notes.nextElementSibling;
    while (next && next.tagName === "P") {
      nodes.push(next);
      next = next.nextElementSibling;
    }

    if (!nodes.length) return;

    const closing = document.createElement("div");
    closing.className = "infos-closing";
    nodes.forEach((node) => closing.append(node));
    if (next) {
      prose.insertBefore(closing, next);
    } else {
      prose.append(closing);
    }
  }

  function setupInfosNotes() {
    const prose = document.querySelector<HTMLElement>(".prose.prose-wide");
    if (!prose || prose.dataset.infosNotesReady === "true") return;

    buildInfosNotes(prose);
    buildInfosClosing(prose);
    if (prose.querySelector(".infos-notes")) {
      prose.dataset.infosNotesReady = "true";
    }
  }

  setupInfosNotes();
  document.addEventListener("astro:page-load", setupInfosNotes);
</script>

<style is:global>
  .infos-notes {
    margin-block: var(--space-lg);
  }

  .infos-notes > h2 {
    margin-top: 0;
    margin-bottom: var(--space-md);
    font-family: var(--font-heading);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-primary-dark);
  }

  .infos-notes-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .infos-notes-card {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.9rem;
    align-items: start;
    margin: 0;
    height: 100%;
    padding: 1.2rem 1.25rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .infos-notes-grid > li + li {
    margin-top: 0;
  }

  .infos-notes-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    flex-shrink: 0;
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--color-primary) 16%, #fff);
    color: var(--color-primary-dark);
  }

  .infos-notes-icon svg {
    width: 1.25rem;
    height: 1.25rem;
    stroke: currentColor;
  }

  .infos-notes-body {
    min-width: 0;
    color: var(--color-text);
    font-size: var(--text-sm);
    font-weight: 300;
    line-height: 1.6;
  }

  .infos-notes-title {
    margin: 0 0 0.35rem;
    font-family: var(--font-heading);
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-primary-dark);
  }

  .infos-notes-text p {
    margin: 0;
    font-weight: 300;
  }

  .infos-notes-text strong {
    font-weight: 600;
  }

  @media (max-width: 820px) {
    .infos-notes {
      margin-block: 0;
    }

    .infos-notes > h2 {
      margin-bottom: var(--space-sm);
      max-width: 40rem;
    }

    .infos-notes-grid {
      grid-template-columns: 1fr;
      gap: 0.65rem;
    }

    .infos-notes-card {
      gap: 0.7rem;
      padding: 0.9rem 0.85rem;
    }

    .infos-notes-icon {
      width: 2.15rem;
      height: 2.15rem;
    }

    .infos-notes-icon svg {
      width: 1.15rem;
      height: 1.15rem;
    }

    .infos-notes-title {
      margin-bottom: 0.25rem;
      font-size: 0.8125rem;
      letter-spacing: 0.06em;
    }

    .infos-notes-body {
      font-size: 0.9375rem;
      line-height: 1.6;
    }
  }

  .infos-closing {
    max-width: 36rem;
    margin: var(--space-lg) auto 0;
    padding: 1.5rem 0 0;
    border-top: 1px solid var(--color-border);
    text-align: center;
    color: var(--color-text-soft);
    font-size: var(--text-base);
    font-weight: 300;
    line-height: 1.7;
  }

  .infos-closing p {
    margin: 0;
    max-width: none;
    font-weight: 300;
  }

  .infos-closing p + p {
    margin-top: 0.85rem;
    font-family: var(--font-heading);
    font-style: italic;
    font-weight: 400;
    color: var(--color-text);
  }

  .page-intro-content h2,
  .infos-cadre,
  .infos-notes {
    scroll-margin-top: 6.5rem;
  }

  #cadre,
  #avant-de-consulter {
    display: block;
    height: 0;
    margin: 0;
    overflow: hidden;
    scroll-margin-top: 6.5rem;
  }

  @media (max-width: 820px) {
    .infos-closing {
      margin-top: 0;
      padding-top: var(--space-md);
    }
  }
</style>
