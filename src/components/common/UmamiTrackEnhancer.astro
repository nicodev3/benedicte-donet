<script>
  import { SITE } from "@/site.config";
  import { getConversionDestination } from "@/lib/umami";

  function emplacementFor(link: HTMLAnchorElement): string {
    if (link.closest("header")) return "navigation";
    if (link.closest(".post .prose")) return "article-corps";
    if (link.closest(".post-service-links, .post-footer")) return "article-bas";
    if (link.closest("footer")) return "pied-de-page";
    if (link.closest("#contact")) return "bloc-contact";
    if (link.closest(".prose")) return "page-contenu";
    return "contenu";
  }

  function tagImportantLinks() {
    const source = window.location.pathname;
    const langue = /^\/en(?:\/|$)/.test(source) ? "en" : "fr";
    const origine = document.querySelector("article.post") ? "article" : "page";

    document.querySelectorAll<HTMLAnchorElement>("a[href]").forEach((link) => {
      const conversion = getConversionDestination(
        link.getAttribute("href") ?? "", window.location.origin, SITE.email
      );
      if (!conversion) return;

      // Conserver les noms et emplacements déjà utilisés dans les rapports Umami.
      if (!link.hasAttribute("data-umami-event")) {
        link.setAttribute("data-umami-event", conversion.event);
      }
      const properties = {
        source, langue, origine,
        destination: conversion.destination,
        emplacement: emplacementFor(link),
      };
      for (const [key, value] of Object.entries(properties)) {
        const attribute = `data-umami-event-${key}`;
        if (!link.hasAttribute(attribute)) link.setAttribute(attribute, value);
      }
    });
  }

  function setup() {
    tagImportantLinks();
    // Les composants qui mettent en forme les liens peuvent s’exécuter après ce script.
    requestAnimationFrame(tagImportantLinks);
    window.setTimeout(tagImportantLinks, 150);
  }

  setup();
  document.addEventListener("astro:page-load", setup);
</script>
