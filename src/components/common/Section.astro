---
interface Props {
  tone?: "default" | "soft" | "muted" | "primary";
  id?: string;
  class?: string;
  style?: Record<string, string | undefined>;
  /** URL d'image de fond chargée seulement près du viewport */
  lazyBg?: string;
  lazyBgVar?: string;
  lazyBgDesktop?: string;
  lazyBgMobile?: string;
}

const {
  tone = "default",
  id,
  class: className = "",
  style,
  lazyBg,
  lazyBgVar,
  lazyBgDesktop,
  lazyBgMobile,
} = Astro.props;
---

<section
  {id}
  class:list={["section", `tone-${tone}`, className]}
  style={style}
  data-lazy-bg={lazyBg}
  data-lazy-bg-var={lazyBgVar}
  data-lazy-bg-desktop={lazyBgDesktop}
  data-lazy-bg-mobile={lazyBgMobile}
>
  <slot />
</section>

<style>
  .section {
    padding-block: var(--section-y);
    /* Diffère le layout des sections hors viewport → moins de travail au chargement */
    content-visibility: auto;
    contain-intrinsic-size: auto 32rem;
  }

  /* Même fond : un seul rythme au lieu de doubler le padding */
  .section.tone-default + .section.tone-default,
  .section.tone-soft + .section.tone-soft,
  .section.tone-muted + .section.tone-muted {
    padding-top: calc(var(--section-y) * 0.45);
  }

  /* Après une citation visuelle : ne jamais compresser (spécificité ≥ règle ci-dessus) */
  .section.quote-section + .section.tone-default,
  .section.quote-section + .section.tone-soft,
  .section.quote-section + .section.tone-muted {
    padding-top: calc(var(--section-y) * 1.25);
  }

  @media (max-width: 820px) {
    .section {
      padding-block: var(--section-y-mobile, var(--section-y));
    }

    .section.tone-default + .section.tone-default,
    .section.tone-soft + .section.tone-soft,
    .section.tone-muted + .section.tone-muted {
      padding-top: calc(var(--section-y-mobile, var(--section-y)) * 0.3);
    }

    .section.quote-section + .section.tone-default,
    .section.quote-section + .section.tone-soft,
    .section.quote-section + .section.tone-muted {
      padding-top: var(--space-xl);
    }
  }

  .tone-soft {
    background: var(--color-bg-soft);
  }

  .tone-muted {
    background: var(--color-bg-muted);
  }

  .tone-primary {
    background: var(--color-primary-strong);
    color: #fff;
  }

  .tone-primary :global(h2),
  .tone-primary :global(h3) {
    color: #fff;
  }
</style>
