---
/**
 * Section « Cadre du suivi » : liste → trois cartes (formation, public, visio).
 */
import { GraduationCap, Users, Video } from "@lucide/astro";

const icons = [
  { key: "formation", Icon: GraduationCap },
  { key: "public", Icon: Users },
  { key: "visio", Icon: Video },
] as const;
---

<div id="infos-cadre-icons" hidden aria-hidden="true">
  {
    icons.map(({ key, Icon }) => (
      <span data-infos-cadre-icon={key}>
        <Icon size={22} stroke-width={1.75} aria-hidden="true" />
      </span>
    ))
  }
</div>

<script>
  function splitLabeledHtml(html: string): { label: string | null; body: string } {
    const wrap = document.createElement("div");
    wrap.innerHTML = html.trim();

    const context =
      wrap.childElementCount === 1 && wrap.firstElementChild?.tagName === "P"
        ? wrap.firstElementChild
        : wrap;

    const strong = [...context.childNodes].find(
      (node): node is HTMLElement =>
        node.nodeType === Node.ELEMENT_NODE && (node as HTMLElement).tagName === "STRONG"
    );
    if (!strong) return { label: null, body: html };

    const raw = strong.textContent?.trim() ?? "";
    if (!/[—–-]/.test(raw)) return { label: null, body: html };

    const label = raw.replace(/\s*[—–-]\s*$/, "").trim();
    strong.remove();
    const body = context.innerHTML.replace(/^\s*(?:<br\s*\/?>)?\s*/, "");
    return { label: label || null, body };
  }

  function buildInfosCadre(prose: HTMLElement) {
    const heading = prose.querySelector<HTMLElement>(
      'h2[id^="votre-psychologue"], h2[id^="your-psychologist"]'
    );
    if (!heading || heading.dataset.infosCadreReady === "true") return;

    const list = heading.nextElementSibling;
    if (!list || list.tagName !== "UL") return;

    const items = [...list.querySelectorAll(":scope > li")];
    if (items.length < 2) return;

    const iconRoot = document.getElementById("infos-cadre-icons");
    const iconSlots = iconRoot
      ? [...iconRoot.querySelectorAll<HTMLElement>("[data-infos-cadre-icon]")]
      : [];

    const section = document.createElement("section");
    section.className = "infos-cadre";
    section.setAttribute("aria-labelledby", heading.id);

    const grid = document.createElement("ul");
    grid.className = "infos-cadre-grid";

    items.forEach((item, index) => {
      const card = document.createElement("li");
      card.className = "infos-cadre-card";

      const iconWrap = document.createElement("span");
      iconWrap.className = "infos-cadre-icon";
      iconWrap.setAttribute("aria-hidden", "true");

      const source = iconSlots[index] ?? iconSlots[iconSlots.length - 1];
      const svg = source?.querySelector("svg")?.cloneNode(true);
      if (svg) iconWrap.append(svg);

      const { label, body } = splitLabeledHtml(item.innerHTML);
      const bodyEl = document.createElement("div");
      bodyEl.className = "infos-cadre-body";

      if (label) {
        const title = document.createElement("p");
        title.className = "infos-cadre-title";
        title.textContent = label;
        bodyEl.append(title);
      }

      const text = document.createElement("div");
      text.className = "infos-cadre-text";
      text.innerHTML = body;
      bodyEl.append(text);

      card.append(iconWrap, bodyEl);
      grid.append(card);
    });

    heading.before(section);
    section.append(heading, grid);
    list.remove();
    heading.dataset.infosCadreReady = "true";
  }

  function setupInfosCadre() {
    const prose = document.querySelector<HTMLElement>(".prose.prose-wide");
    if (!prose || prose.dataset.infosCadreReady === "true") return;

    buildInfosCadre(prose);
    if (prose.querySelector(".infos-cadre")) {
      prose.dataset.infosCadreReady = "true";
    }
  }

  setupInfosCadre();
  document.addEventListener("astro:page-load", setupInfosCadre);
</script>

<style is:global>
  .infos-cadre {
    margin-block: var(--space-lg);
  }

  .infos-cadre > h2 {
    margin-top: 0;
    margin-bottom: var(--space-md);
    font-family: var(--font-heading);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-primary-dark);
  }

  .infos-cadre-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    align-items: stretch;
  }

  .infos-cadre-card {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    margin: 0;
    height: 100%;
    padding: 1.25rem 1.2rem 1.35rem;
    background: var(--color-bg-muted);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .infos-cadre-grid > li + li {
    margin-top: 0;
  }

  .infos-cadre-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--color-secondary) 20%, #fff);
    color: var(--color-secondary-dark);
  }

  .infos-cadre-icon svg {
    width: 1.3rem;
    height: 1.3rem;
    stroke: currentColor;
  }

  .infos-cadre-body {
    min-width: 0;
    color: var(--color-text);
    font-size: var(--text-sm);
    font-weight: 300;
    line-height: 1.6;
  }

  .infos-cadre-title {
    margin: 0 0 0.4rem;
    font-family: var(--font-heading);
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-primary-dark);
  }

  .infos-cadre-text p {
    margin: 0;
    font-weight: 300;
  }

  .infos-cadre-text strong {
    font-weight: 600;
  }

  @media (max-width: 900px) {
    .infos-cadre {
      margin-block: 0;
    }

    .infos-cadre > h2 {
      margin-bottom: var(--space-sm);
      max-width: 40rem;
    }

    .infos-cadre-grid {
      grid-template-columns: 1fr;
      gap: 0.65rem;
    }

    .infos-cadre-card {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      align-items: start;
      gap: 0.7rem;
      padding: 0.9rem 0.85rem;
    }

    .infos-cadre-icon {
      width: 2.15rem;
      height: 2.15rem;
    }

    .infos-cadre-icon svg {
      width: 1.15rem;
      height: 1.15rem;
    }

    .infos-cadre-title {
      margin-bottom: 0.25rem;
      font-size: 0.8125rem;
      letter-spacing: 0.06em;
    }

    .infos-cadre-body {
      font-size: 0.9375rem;
      line-height: 1.6;
    }
  }
</style>
