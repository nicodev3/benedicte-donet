---
/**
 * Section « Prise de rendez-vous » : liste → points clés avec icônes et libellés.
 */
import { CalendarRange, Clock, Handshake, Video } from "@lucide/astro";

const icons = [
  { key: "duree", Icon: Clock },
  { key: "rythme", Icon: CalendarRange },
  { key: "format", Icon: Video },
  { key: "dispo", Icon: Handshake },
] as const;
---

<div id="infos-booking-icons" hidden aria-hidden="true">
  {
    icons.map(({ key, Icon }) => (
      <span data-infos-booking-icon={key}>
        <Icon size={20} stroke-width={1.75} aria-hidden="true" />
      </span>
    ))
  }
</div>

<script>
  function splitLabeledHtml(html: string): { label: string | null; body: string } {
    const wrap = document.createElement("div");
    wrap.innerHTML = html.trim();

    const context =
      wrap.childElementCount === 1 && wrap.firstElementChild?.tagName === "P"
        ? wrap.firstElementChild
        : wrap;

    const strong = [...context.childNodes].find(
      (node): node is HTMLElement =>
        node.nodeType === Node.ELEMENT_NODE && (node as HTMLElement).tagName === "STRONG"
    );
    if (!strong) return { label: null, body: html };

    const raw = strong.textContent?.trim() ?? "";
    if (!/[—–-]/.test(raw)) return { label: null, body: html };

    const label = raw.replace(/\s*[—–-]\s*$/, "").trim();
    strong.remove();
    const body = context.innerHTML.replace(/^\s*(?:<br\s*\/?>)?\s*/, "");
    return { label: label || null, body };
  }

  function buildInfosBooking(prose: HTMLElement) {
    const heading = prose.querySelector<HTMLElement>(
      'h2[id^="prise-de-rendez"], h2[id^="booking-an-appointment"]'
    );
    if (!heading || heading.dataset.infosBookingReady === "true") return;

    const lead = heading.nextElementSibling;
    if (!lead || lead.tagName !== "P") return;

    const list = lead.nextElementSibling;
    if (!list || list.tagName !== "UL") return;

    const items = [...list.querySelectorAll(":scope > li")];
    if (items.length < 2) return;

    const iconRoot = document.getElementById("infos-booking-icons");
    const iconSlots = iconRoot
      ? [...iconRoot.querySelectorAll<HTMLElement>("[data-infos-booking-icon]")]
      : [];

    lead.classList.add("infos-booking-lead");

    const facts = document.createElement("ul");
    facts.className = "infos-booking-list";
    facts.setAttribute("aria-label", heading.textContent?.trim() ?? "");

    items.forEach((item, index) => {
      const row = document.createElement("li");
      row.className = "infos-booking-item";

      const iconWrap = document.createElement("span");
      iconWrap.className = "infos-booking-icon";
      iconWrap.setAttribute("aria-hidden", "true");

      const source = iconSlots[index] ?? iconSlots[iconSlots.length - 1];
      const svg = source?.querySelector("svg")?.cloneNode(true);
      if (svg) iconWrap.append(svg);

      const { label, body } = splitLabeledHtml(item.innerHTML);
      const bodyEl = document.createElement("div");
      bodyEl.className = "infos-booking-body";

      if (label) {
        const title = document.createElement("p");
        title.className = "infos-booking-label";
        title.textContent = label;
        bodyEl.append(title);
      }

      const text = document.createElement("div");
      text.className = "infos-booking-text";
      text.innerHTML = body;
      bodyEl.append(text);

      row.append(iconWrap, bodyEl);
      facts.append(row);
    });

    list.replaceWith(facts);
    heading.dataset.infosBookingReady = "true";
  }

  function setupInfosBooking() {
    const root =
      document.querySelector<HTMLElement>(".page-intro-content") ??
      document.querySelector<HTMLElement>(".prose.prose-wide");
    if (!root || root.dataset.infosBookingReady === "true") return;

    buildInfosBooking(root);
    if (root.querySelector(".infos-booking-list")) {
      root.dataset.infosBookingReady = "true";
    }
  }

  setupInfosBooking();
  document.addEventListener("astro:page-load", setupInfosBooking);
</script>

<style is:global>
  .page-intro-content h2 {
    scroll-margin-top: 6.5rem;
  }

  .page-intro-content .infos-booking-lead {
    margin: 0;
    color: var(--color-text-soft);
    font-size: var(--text-base);
    font-weight: 300;
    line-height: 1.65;
  }

  .page-intro-content .infos-booking-list,
  .infos-booking-list {
    list-style: none;
    margin: var(--section-y-mobile, 2rem) 0 0;
    padding: 0;
    display: grid;
    gap: 0.55rem;
  }

  .infos-booking-item {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.75rem;
    align-items: start;
    margin: 0;
    padding: 0.7rem 0;
    background: transparent;
    border: none;
    border-radius: 0;
  }

  .infos-booking-list > li + li {
    margin-top: 0;
  }

  .infos-booking-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.15rem;
    height: 2.15rem;
    flex-shrink: 0;
    margin-top: 0.05rem;
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--color-primary) 16%, #fff);
    color: var(--color-primary-dark);
  }

  .infos-booking-icon svg {
    width: 1.15rem;
    height: 1.15rem;
    stroke: currentColor;
  }

  .infos-booking-body {
    min-width: 0;
    color: var(--color-text);
    font-size: var(--text-sm);
    font-weight: 300;
    line-height: 1.55;
  }

  /* Spécificité > .page-intro-content p (sinon libellés à 300) */
  .page-intro-content .infos-booking-label,
  .infos-booking-label {
    margin: 0 0 0.15rem;
    font-family: var(--font-heading);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-primary-dark);
  }

  .infos-booking-text p {
    margin: 0;
    font-weight: 300;
  }

  .infos-booking-text strong {
    color: var(--color-primary-dark);
    font-weight: 600;
  }

  .page-intro-content .page-cta {
    margin-top: var(--space-md);
    text-align: left;
  }

  .page-intro-content .page-cta a {
    font-size: 1.0625rem;
    padding: 0.7rem 1.35rem;
  }

  @media (max-width: 820px) {
    .page-intro-content .infos-booking-list,
    .infos-booking-list {
      gap: 0.75rem;
    }

    .infos-booking-item {
      gap: 0.65rem;
      padding: 0;
    }

    .infos-booking-icon {
      width: 2rem;
      height: 2rem;
    }

    .infos-booking-body {
      font-size: 0.9375rem;
      line-height: 1.6;
    }
  }
</style>
