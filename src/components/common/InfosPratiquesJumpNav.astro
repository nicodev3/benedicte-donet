---
import { getLocaleFromPath } from "@/lib/i18n";
import { useTranslations } from "@/lib/translations";

const locale = getLocaleFromPath(Astro.url.pathname);
const t = useTranslations(locale);
const links =
  locale === "fr"
    ? [
        { href: "#prise-de-rendez-vous", label: t.infosPratiques.jumpNav.booking },
        { href: "#tarifs-des-consultations-en-ligne", label: t.infosPratiques.jumpNav.fees },
        { href: "#cadre", label: t.infosPratiques.jumpNav.framework },
        { href: "#avant-de-consulter", label: t.infosPratiques.jumpNav.notes },
        { href: "#contact", label: t.infosPratiques.jumpNav.contact },
      ]
    : [
        { href: "#booking-an-appointment", label: t.infosPratiques.jumpNav.booking },
        { href: "#online-consultation-fees", label: t.infosPratiques.jumpNav.fees },
        { href: "#cadre", label: t.infosPratiques.jumpNav.framework },
        { href: "#avant-de-consulter", label: t.infosPratiques.jumpNav.notes },
        { href: "#contact", label: t.infosPratiques.jumpNav.contact },
      ];
---

<nav class="infos-jump" aria-label={t.infosPratiques.jumpNavLabel}>
  <ul class="infos-jump-list">
    {
      links.map((link) => (
        <li>
          <a href={link.href}>{link.label}</a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .infos-jump {
    margin: var(--space-lg) auto 0;
  }

  .infos-jump-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 0.55rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  a {
    display: inline-flex;
    align-items: center;
    padding: 0.45rem 0.95rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    background: var(--color-bg-muted);
    color: var(--color-primary-dark);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: 0.02em;
    text-decoration: none;
    transition:
      background var(--transition),
      border-color var(--transition),
      color var(--transition);
  }

  a:hover {
    background: var(--color-bg-soft);
    border-color: var(--color-primary);
    color: var(--color-primary-stronger);
  }

  @media (max-width: 820px) {
    .infos-jump {
      margin-top: var(--space-md);
    }
  }
</style>
