---
import { getOptimizedImage } from "@/lib/images";
import { preventPunctuationWrap } from "@/lib/typography";

interface Props {
  title: string;
  backgroundImage?: string;
  backgroundImageAlt: string;
  backgroundPosition?: string;
}

const {
  title,
  backgroundImage,
  backgroundImageAlt,
  backgroundPosition = "center right",
} = Astro.props;

const heroImage = await getOptimizedImage(backgroundImage, {
  widths: [414, 640, 828, 1200],
  format: "webp",
  quality: 65,
});
---

<section class="post-hero">
  <div
    class="post-hero-panel"
    style={{
      "--post-hero-bg-position": backgroundPosition,
    }}
  >
    {
      heroImage && (
        <img
          class="post-hero-bg"
          src={heroImage.src}
          srcset={heroImage.srcset}
          sizes="100vw"
          alt={backgroundImageAlt}
          width={Number(heroImage.attributes.width || 828)}
          height={Number(heroImage.attributes.height || 1104)}
          loading="eager"
          fetchpriority="high"
          decoding="sync"
        />
      )
    }
    <div class="post-hero-overlay" aria-hidden="true" />
    <div class="post-hero-content">
      <h1>{preventPunctuationWrap(title)}</h1>
    </div>
  </div>
</section>

<style>
  .post-hero {
    padding-block: 0;
  }

  .post-hero-panel {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    min-height: clamp(14rem, 40vw, 22rem);
    text-align: center;
    border-radius: 0 0 5rem 0;
    box-shadow: 3px 6px 15px rgba(0, 0, 0, 0.25);
    background-color: var(--color-bg-soft);
  }

  .post-hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--post-hero-bg-position, center right);
  }

  .post-hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
    background: rgba(255, 255, 255, 0.51);
    pointer-events: none;
  }

  .post-hero-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: 52rem;
    padding: 3.125rem 1.5rem;
  }

  .post-hero-content h1 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 1.2rem + 1.8vw, 2.6875rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    line-height: 1.2;
    color: var(--color-text);
  }

  @media (min-width: 768px) {
    .post-hero-panel {
      width: 100vw;
      margin-left: calc(50% - 50vw);
    }
  }

  @media (max-width: 767px) {
    .post-hero {
      padding-inline: var(--space-md);
    }

    .post-hero-panel {
      border-radius: 0 0 3.75rem 0;
    }

    .post-hero-bg {
      object-position: top center;
    }

    .post-hero-content {
      padding: 2.5rem 1rem;
    }
  }
</style>
