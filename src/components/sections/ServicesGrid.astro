---
import Container from "@/components/common/Container.astro";
import Section from "@/components/common/Section.astro";
import SiteImage from "@/components/common/SiteImage.astro";
import Button from "@/components/common/Button.astro";
import { renderInlineRichText } from "@/lib/rich-text";
import { doctolibEventFor } from "@/lib/umami";

interface Card {
  title?: string;
  intro?: string;
  bullets?: string[];
  text?: string;
  url: string;
  imageUrl?: string;
  linkLabel?: string;
  linkUrl?: string;
  ctaLabel?: string;
  ctaUrl?: string;
  image?: string;
  imageWidth?: "narrow" | "wide";
}

interface Props {
  title: string;
  cards: Card[];
  tone?: "default" | "soft" | "muted";
}

const { title, cards, tone = "default" } = Astro.props;

---

<Section class="services-section" {tone}>
  <Container>
    <h2 class="services-title">{title}</h2>
    <div class:list={["services-stack", { "is-single": cards.length === 1 }]}>
      {
        cards.map((card, index) => {
          const align = index % 2 === 0 ? "start" : "end";
          const footerHref = card.linkUrl || card.url;
          const ctaHref = card.ctaUrl || card.url;
          const doctolibEvent = doctolibEventFor(ctaHref);
          const ctaUmami = doctolibEvent
            ? {
                event: doctolibEvent,
                props: { emplacement: "carte-service" },
              }
            : undefined;

          return (
            <article class:list={["service-card", `align-${align}`]}>
              <div class="service-card-inner">
                {
                  card.image && (
                    <div class="service-visual">
                      <div
                        class:list={[
                          "service-image",
                          { narrow: card.imageWidth === "narrow" },
                        ]}
                      >
                        <SiteImage
                          src={card.image}
                          alt={
                            card.title
                              ? `Illustration : ${card.title}`
                              : "Illustration de l'accompagnement proposé"
                          }
                          width={160}
                          widths={[96, 120, 160]}
                          sizes="100px"
                          quality={65}
                          loading="lazy"
                        />
                      </div>
                    </div>
                  )
                }
                {card.title && <h3>{card.title}</h3>}
                <div class="service-body">
                  {card.intro && <p set:html={renderInlineRichText(card.intro)} />}
                  {
                    card.bullets && (
                      <ul>
                        {card.bullets.map((item) => (
                          <li set:html={renderInlineRichText(item)} />
                        ))}
                      </ul>
                    )
                  }
                  {!card.bullets && card.text && <p set:html={renderInlineRichText(card.text)} />}
                  {card.bullets && card.text && <p set:html={renderInlineRichText(card.text)} />}
                  {
                    card.linkLabel && (
                      <p class="service-link">
                        <strong>
                          <a href={footerHref}>{card.linkLabel}</a>
                        </strong>
                        .
                      </p>
                    )
                  }
                </div>
              </div>
              {
                card.ctaLabel && (
                  <div class="service-cta">
                    <Button
                      href={ctaHref}
                      class="service-button"
                      umamiEvent={ctaUmami?.event}
                      umamiProps={ctaUmami?.props}
                    >
                      {card.ctaLabel}
                    </Button>
                  </div>
                )
              }
            </article>
          );
        })
      }
    </div>
  </Container>
</Section>

<style>
  :global(.section.services-section) {
    padding-block: clamp(3.75rem, 6vw, 5.5rem) clamp(2rem, 4vw, 3rem);
  }

  @media (max-width: 820px) {
    :global(.section.services-section) {
      padding-block: var(--section-y-mobile, var(--section-y));
    }
  }

  .services-title {
    text-align: center;
    font-family: var(--font-heading);
    font-weight: 400;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-primary-dark);
    margin-bottom: clamp(2.25rem, 4vw, 3.25rem);
  }

  .services-stack {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: start;
    gap: clamp(1.5rem, 3vw, 2.75rem);
    width: 100%;
    max-width: none;
    margin-inline: auto;
  }

  .services-stack.is-single {
    grid-template-columns: minmax(0, 32rem);
    justify-content: center;
  }

  .service-card {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
  }

  .service-card.align-start,
  .service-card.align-end {
    align-self: stretch;
  }

  .service-card-inner {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding: 2rem 2.25rem 2.5rem;
    background: rgb(103 199 202 / 0.13);
    border: 1px solid rgb(103 199 202 / 0.22);
    border-radius: 5.625rem 0 5.625rem 0;
    box-shadow: 0 14px 40px rgba(59, 46, 56, 0.08);
  }

  .service-visual {
    display: flex;
    justify-content: center;
    width: 68%;
    max-width: 17rem;
    margin-bottom: 0;
  }

  .service-image {
    display: block;
    width: 7.5rem;
    height: 8.5rem;
    filter: drop-shadow(0 8px 16px rgba(59, 46, 56, 0.08));
  }

  .service-image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    margin-inline: auto;
  }

  .service-card-inner h3 {
    text-align: center;
    font-family: var(--font-heading);
    font-size: clamp(1.125rem, 1rem + 0.45vw, 1.5rem);
    font-weight: 400;
    letter-spacing: 0.03em;
    line-height: 1.35;
    margin: 0;
    max-width: 16em;
    color: var(--color-primary-dark);
  }

  .service-body {
    width: 100%;
    background: #fff;
    margin-inline: 0;
    padding: 1.5rem 1.75rem 1.65rem;
    border: 1px solid rgb(234 223 219 / 0.9);
    border-radius: 1.5rem 0 0 0;
    box-shadow: 0 6px 22px rgba(59, 46, 56, 0.05);
    font-size: 1rem;
    font-weight: 300;
    line-height: 1.7;
    text-align: start;
    color: var(--color-text);
  }

  .service-body :global(p:first-child) {
    margin: 0 0 0.9rem;
    font-weight: 400;
    color: var(--color-primary-dark);
  }

  .service-body :global(p + p),
  .service-body :global(ul + p),
  .service-body :global(p + ul) {
    margin-top: 0.9rem;
  }

  .service-body ul {
    margin: 0;
    padding-left: 0;
    list-style: none;
  }

  .service-body li {
    position: relative;
    padding-left: 1.25rem;
  }

  .service-body li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.7em;
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 50%;
    background: var(--color-secondary-dark);
  }

  .service-body li + li {
    margin-top: 0.45rem;
  }

  .service-body :global(a) {
    color: var(--color-primary-dark);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .service-body :global(a:hover) {
    color: var(--color-primary-stronger);
  }

  .service-link {
    margin-top: 1.15rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
  }

  .service-link strong {
    font-weight: 500;
  }

  .service-cta {
    margin-top: var(--space-md);
    text-align: center;
  }

  .service-cta :global(.service-button) {
    border-radius: 35px 0 35px 0;
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 1.25rem;
    padding: 0.75rem 1.45rem;
  }

  @media (max-width: 1024px) {
    .service-card-inner {
      padding-inline: 2rem;
    }

    .service-visual {
      width: 72%;
      max-width: 14rem;
    }
  }

  @media (max-width: 767px) {
    .services-stack {
      grid-template-columns: 1fr;
      width: 100%;
    }

    .service-card,
    .service-card.align-start,
    .service-card.align-end {
      align-self: stretch;
      width: 100%;
    }

    .service-card-inner {
      border-radius: 3.75rem 0 3.75rem 0;
      padding: 1.5rem 1.5rem 2.25rem;
      gap: 0.85rem;
    }

    .service-visual {
      width: 78%;
      max-width: 12rem;
    }

    .service-card-inner h3 {
      font-size: 1.125rem;
    }

    .service-body {
      align-self: stretch;
      width: 100%;
      margin-inline: 0;
      padding: 1.25rem 1.25rem 1.35rem;
      border-radius: 1.15rem 0 0 0;
      font-size: 0.9375rem;
      box-sizing: border-box;
    }

    .service-cta :global(.service-button) {
      font-size: 0.9375rem;
    }
  }
</style>
