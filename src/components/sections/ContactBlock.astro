---
import Container from "@/components/common/Container.astro";
import Section from "@/components/common/Section.astro";
import Button from "@/components/common/Button.astro";
import { getSiteGlobal } from "@/site.config";
import { getLocaleFromPath } from "@/lib/i18n";
import { UMAMI_EVENTS } from "@/lib/umami";

interface Props { legacyFormAnchor?: boolean; }
const { legacyFormAnchor = false } = Astro.props;
const locale = getLocaleFromPath(Astro.url.pathname);
const global = getSiteGlobal(locale);
const labels = locale === "fr" ? {
  title: "Prendre rendez-vous ou poser une question",
  bookingTitle: "Votre consultation en ligne",
  bookingText: "Consultez les créneaux proposés sur Doctolib et choisissez votre rendez-vous en visio.",
  bookingCta: "Prendre rendez-vous en visio",
  emailTitle: "Une question avant de consulter ?",
  emailText: "Pour une question sur les séances, les tarifs ou les autres accompagnements, vous pouvez m’écrire directement.",
  emailCta: "M’écrire par email",
} : {
  title: "Book an appointment or ask a question",
  bookingTitle: "Your online consultation",
  bookingText: "View available appointments on Doctolib and choose your video consultation.",
  bookingCta: "Book a video consultation",
  emailTitle: "A question before booking?",
  emailText: "For questions about sessions, fees or other services, you can email me directly.",
  emailCta: "Email me",
};
---

<Section id="contact" tone="soft" style={{ "scroll-margin-top": "6rem" }}>
  <Container>
    {legacyFormAnchor && <span id="form" aria-hidden="true"></span>}
    <h2>{labels.title}</h2>
    <div class="contact-grid">
      <div class="contact-card">
        <h3>{labels.bookingTitle}</h3>
        <p>{labels.bookingText}</p>
        <Button href={global.appointmentUrl} umamiEvent={UMAMI_EVENTS.DOCTOLIB}
          umamiProps={{ emplacement: "bloc-contact", langue: locale }}>{labels.bookingCta}</Button>
      </div>
      <div class="contact-card">
        <h3>{labels.emailTitle}</h3>
        <p>{labels.emailText}</p>
        <Button href={`mailto:${global.email}`} variant="outline" umamiEvent={UMAMI_EVENTS.EMAIL}
          umamiProps={{ emplacement: "bloc-contact", langue: locale }}>{labels.emailCta}</Button>
        <p class="contact-address">{global.email}</p>
      </div>
    </div>
  </Container>
</Section>

<style>
  #form { scroll-margin-top: 6rem; }
  h2 { text-align: center; margin: 0 0 var(--space-lg); }
  .contact-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-lg); }
  .contact-card { padding: var(--space-lg); border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-bg); }
  h3 { margin: 0 0 var(--space-sm); }
  p { margin: 0 0 var(--space-md); }
  .contact-address { margin: var(--space-sm) 0 0; overflow-wrap: anywhere; font-size: var(--text-sm); }
  @media (max-width: 700px) { .contact-grid { grid-template-columns: 1fr; } }
</style>
