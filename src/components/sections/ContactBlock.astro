---
import Container from "@/components/common/Container.astro";
import Section from "@/components/common/Section.astro";
import Button from "@/components/common/Button.astro";
import { getSiteGlobal } from "@/site.config";
import { getLocaleFromPath } from "@/lib/i18n";
import { UMAMI_EVENTS } from "@/lib/umami";

interface Props { legacyFormAnchor?: boolean; }
const { legacyFormAnchor = false } = Astro.props;
const locale = getLocaleFromPath(Astro.url.pathname);
const global = getSiteGlobal(locale);
const labels = locale === "fr" ? {
  title: "Prendre rendez-vous ou poser une question",
  bookingTitle: "Votre consultation en ligne",
  bookingText: "Consultez les créneaux proposés sur Doctolib et choisissez votre rendez-vous en visio.",
  bookingCta: "Prendre rendez-vous en visio",
  emailTitle: "Une question avant de consulter ?",
  emailText: "Pour une question sur les séances, les tarifs ou les autres accompagnements, vous pouvez m’écrire via la messagerie Doctolib ou par email.",
  messageCta: "Envoyer un message via Doctolib",
  emailCta: "M’écrire par email",
} : {
  title: "Book an appointment or ask a question",
  bookingTitle: "Your online consultation",
  bookingText: "View available appointments on Doctolib and choose your video consultation.",
  bookingCta: "Book a video consultation",
  emailTitle: "A question before booking?",
  emailText: "For questions about sessions, fees or other services, you can write via Doctolib messaging or email.",
  messageCta: "Send a message via Doctolib",
  emailCta: "Email me",
};
---

<Section id="contact" tone="soft" style={{ "scroll-margin-top": "6rem" }}>
  <Container>
    {legacyFormAnchor && <span id="form" aria-hidden="true"></span>}
    <h2>{labels.title}</h2>
    <div class="contact-grid">
      <div class="contact-card">
        <h3>{labels.bookingTitle}</h3>
        <p>{labels.bookingText}</p>
        <Button href={global.appointmentUrl} umamiEvent={UMAMI_EVENTS.DOCTOLIB}
          umamiProps={{ emplacement: "bloc-contact", langue: locale }}>{labels.bookingCta}</Button>
      </div>
      <div class="contact-card">
        <h3>{labels.emailTitle}</h3>
        <p>{labels.emailText}</p>
        <div class="contact-actions">
          <Button href={global.messageUrl} variant="outline" umamiEvent={UMAMI_EVENTS.DOCTOLIB_MESSAGE}
            umamiProps={{ emplacement: "bloc-contact", langue: locale }}>{labels.messageCta}</Button>
          <a
            class="contact-email-link"
            href={`mailto:${global.email}`}
            data-umami-event={UMAMI_EVENTS.EMAIL}
            data-umami-event-emplacement="bloc-contact"
            data-umami-event-langue={locale}
          >{labels.emailCta}</a>
          <p class="contact-address">{global.email}</p>
        </div>
      </div>
    </div>
  </Container>
</Section>

<style>
  #form { scroll-margin-top: 6rem; }
  h2 {
    text-align: center;
    margin: 0 0 var(--space-lg);
    font-family: var(--font-heading);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-primary-dark);
  }
  .contact-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-lg);
  }
  .contact-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: var(--space-lg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg);
  }
  h3 {
    margin: 0 0 var(--space-sm);
  }
  .contact-card > p {
    margin: 0 0 var(--space-md);
    flex: 1 1 auto;
  }
  .contact-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.65rem;
    width: 100%;
  }
  .contact-email-link {
    font-size: var(--text-sm);
    font-weight: 500;
  }
  .contact-address {
    margin: 0;
    overflow-wrap: anywhere;
    font-size: var(--text-sm);
    color: var(--color-text-soft);
  }
  @media (max-width: 700px) {
    .contact-grid { grid-template-columns: 1fr; }
  }
</style>
