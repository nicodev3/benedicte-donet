---
import { getCollection, render } from "astro:content";
import { isStandardPage } from "@/lib/pages";
import PageLayout from "@/layouts/PageLayout.astro";
import OptimizedContent from "@/components/common/OptimizedContent.astro";
import ProductsGrid from "@/components/sections/ProductsGrid.astro";
import { SITE } from "@/site.config";
import { resolveSeoImagePath } from "@/lib/images";
import { getMasterclassProducts } from "@/lib/masterclass-products";
import { parsePrice } from "@/lib/pricing";
import { getContentSlug, getLocaleFromPath, localizedPath, type Locale } from "@/lib/i18n";

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? getLocaleFromPath(Astro.url.pathname);
const products = getMasterclassProducts(locale);

const page = (await getCollection("pages")).filter(isStandardPage).find(
  (entry) =>
    getContentSlug(entry.filePath, entry.id) === "masterclass" &&
    entry.filePath?.includes(`.${locale}.`)
);
if (!page) {
  return Astro.redirect(localizedPath("/404/", locale));
}

const masterclassPath = localizedPath("/masterclass/", locale);
const productImagePaths = await Promise.all(
  products.map((product) => resolveSeoImagePath(product.image))
);
const productListStructuredData = {
  "@type": "ItemList",
  "@id": new URL(`${masterclassPath}#products`, SITE.url).href,
  name: locale === "en" ? "Masterclasses and programmes" : "Masterclass et programmes",
  itemListElement: products.map((product, index) => {
    const productUrl = new URL(localizedPath(`/produit/${product.slug}/`, locale), SITE.url).href;
    const imagePath = productImagePaths[index];

    return {
      "@type": "ListItem",
      position: index + 1,
      item: {
        "@type": "Product",
        name: [product.title, product.subtitle].filter(Boolean).join(" "),
        image: imagePath ? new URL(imagePath, SITE.url).href : undefined,
        url: productUrl,
        offers: {
          "@type": "Offer",
          url: new URL(localizedPath("/infos-pratiques/#contact", locale), SITE.url).href,
          priceCurrency: "EUR",
          price: parsePrice(product.price),
          availability: "https://schema.org/InStock",
        },
      },
    };
  }),
};

/**
 * Le titre de section vit dans le markdown de la page (éditable dans le CMS) :
 * la grille produits vient se placer juste après lui. Si le titre est renommé ou
 * supprimé, la grille reste affichée à sa position de repli, en fin de page.
 */
const productsHeadingIds =
  locale === "en"
    ? ["masterclasses-and-programmes", "masterclass-and-programmes"]
    : ["masterclass-et-programmes", "les-masterclass-et-programmes"];

const { Content } = await render(page);
---

<PageLayout page={page} structuredData={productListStructuredData}>
  <OptimizedContent
    Content={Content}
    eagerFirst
    sizes="(max-width: 820px) 90vw, 480px"
  />
  <div id="masterclass-products" data-products-headings={productsHeadingIds.join(",")}>
    <span id="masterclass" aria-hidden="true" style="scroll-margin-top: 6rem"></span>
    <ProductsGrid products={products} locale={locale} />
  </div>
</PageLayout>

<script>
  function placeProductsGrid() {
    const block = document.getElementById("masterclass-products");
    if (!block || block.dataset.placed === "true") return;

    const ids = (block.dataset.productsHeadings ?? "").split(",").filter(Boolean);
    const heading = ids
      .map((id) => document.getElementById(id))
      .find((element): element is HTMLElement => element instanceof HTMLElement);

    if (heading) heading.after(block);
    block.dataset.placed = "true";
  }

  placeProductsGrid();
  document.addEventListener("astro:page-load", placeProductsGrid);
</script>
