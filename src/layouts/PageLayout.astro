---
import BaseLayout from "./BaseLayout.astro";
import ContactBlock from "@/components/sections/ContactBlock.astro";
import Container from "@/components/common/Container.astro";
import Section from "@/components/common/Section.astro";
import Hero from "@/components/sections/Hero.astro";
import ServicesHero from "@/components/sections/ServicesHero.astro";
import Breadcrumb from "@/components/common/Breadcrumb.astro";
import PhotoGalleryEnhancer from "@/components/common/PhotoGalleryEnhancer.astro";
import PageIntroEnhancer from "@/components/common/PageIntroEnhancer.astro";
import PageCtaEnhancer from "@/components/common/PageCtaEnhancer.astro";
import AboutImageSplitEnhancer from "@/components/common/AboutImageSplitEnhancer.astro";
import ProseQuoteEnhancer from "@/components/common/ProseQuoteEnhancer.astro";
import PsychotherapieApproachEnhancer from "@/components/common/PsychotherapieApproachEnhancer.astro";
import PsychotherapieSpecialitesEnhancer from "@/components/common/PsychotherapieSpecialitesEnhancer.astro";
import PsychotherapieTarifEnhancer from "@/components/common/PsychotherapieTarifEnhancer.astro";
import ServicesHeroEnhancer from "@/components/common/ServicesHeroEnhancer.astro";
import ServicesIntroEnhancer from "@/components/common/ServicesIntroEnhancer.astro";
import ServicesSectionsEnhancer from "@/components/common/ServicesSectionsEnhancer.astro";
import ServicesMediaEnhancer from "@/components/common/ServicesMediaEnhancer.astro";
import PhotoOffersEnhancer from "@/components/common/PhotoOffersEnhancer.astro";
import PhotoProcessEnhancer from "@/components/common/PhotoProcessEnhancer.astro";
import PhotoTestimonialsEnhancer from "@/components/common/PhotoTestimonialsEnhancer.astro";
import InfosPratiquesBookingEnhancer from "@/components/common/InfosPratiquesBookingEnhancer.astro";
import InfosPratiquesNotesEnhancer from "@/components/common/InfosPratiquesNotesEnhancer.astro";
import InfosPratiquesCadreEnhancer from "@/components/common/InfosPratiquesCadreEnhancer.astro";
import InfosPratiquesJumpNav from "@/components/common/InfosPratiquesJumpNav.astro";
import ReviewsBlock from "@/components/sections/ReviewsBlock.astro";
import RelatedPostsCarousel from "@/components/sections/RelatedPostsCarousel.astro";
import { getLatestPosts } from "@/lib/blog";
import { getCollection } from "astro:content";
import { SITE } from "@/site.config";
import {
  buildBreadcrumbStructuredData,
  buildBreadcrumbs,
} from "@/lib/breadcrumbs";
import { getHomeSettings } from "@/lib/settings";
import { getNavigationItems } from "@/lib/navigation";
import { getContentSlug, getLocaleFromPath } from "@/lib/i18n";
import { useTranslations } from "@/lib/translations";
import { getOptimizedImage } from "@/lib/images";
import type { StandardPageEntry } from "@/lib/pages";

interface Props {
  page: StandardPageEntry;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const { page, structuredData } = Astro.props;
const { title, heroTitle, description, image, imageAlt, seoTitle, seoDescription } = page.data;
const hasHero = Boolean(image);
const pageSlug = getContentSlug(page.filePath, page.id);
const lcpSource =
  pageSlug === "services" ? "/images/heroes/hero-services.jpg" : hasHero ? image : undefined;
const lcpImage = lcpSource
  ? await getOptimizedImage(lcpSource, {
      widths: [414, 640, 828],
      format: "webp",
      quality: 65,
    })
  : undefined;

const locale = getLocaleFromPath(Astro.url.pathname);
const heroCta =
  pageSlug === "psychotherapie" || pageSlug === "infos-pratiques"
    ? {
        label:
          locale === "fr" ? "Prendre rendez-vous en visio" : "Book a video consultation",
        url: SITE.appointmentUrl,
      }
    : null;
const t = useTranslations(locale);
const homeReviews =
  pageSlug === "infos-pratiques" ? (await getHomeSettings(locale)).reviews : null;
const journalPosts =
  pageSlug === "services"
    ? getLatestPosts(await getCollection("blog"), locale)
    : [];
const breadcrumbs = buildBreadcrumbs(
  Astro.url.pathname,
  title,
  getNavigationItems(locale),
  undefined,
  locale
);

function getInfosFaqStructuredData() {
  const questions =
    locale === "fr"
      ? [
          {
            name: "Puis-je vous écrire avant de réserver ?",
            text: "Oui. Pour une question sur les séances ou les tarifs, vous pouvez m’écrire par email ou passer par la messagerie Doctolib. Pour choisir un créneau, consultez directement mon agenda.",
          },
          {
            name: "Quelle est la régularité conseillée pour les séances ?",
            text: "Nous en discutons lors de notre première séance, mais le choix final dépendra de votre capacité à recevoir, du temps nécessaire pour intégrer chaque séance et de vos envies. Nous avons tous un rythme et des besoins différents : nos séances s’adaptent à votre sensibilité.",
          },
          {
            name: "Pourquoi les séances durent-elles 1 h 30 ?",
            text: "Il m’est important de vous offrir un espace et un temps suffisamment spacieux pour sentir, se déposer, partager. L’espace de soin est, à mon sens, un espace à protéger d’un besoin ou d’une envie de précipiter. Ainsi, nous pouvons prendre le temps que requiert la rencontre avec votre monde intérieur.",
          },
        ]
      : [
          {
            name: "Can I contact you before booking?",
            text: "Yes. For a question about sessions or fees, you can email me or use Doctolib messaging. To choose a time slot, go directly to my Doctolib calendar.",
          },
          {
            name: "How often should sessions take place?",
            text: "We discuss this during our first session, but the final choice depends on your capacity to receive, the time needed to integrate each session and your own wishes. We all have different rhythms and needs: sessions adapt to your sensitivity.",
          },
          {
            name: "Why do sessions last 1 hour 30?",
            text: "It matters to me to offer a space and a time roomy enough to feel, to settle and to share. The space of care is, to my mind, a space to protect from any need to rush. That way we can take the time that meeting your inner world requires.",
          },
        ];

  return {
    "@type": "FAQPage",
    "@id": `${new URL(Astro.url.pathname, SITE.url).href}#faq`,
    mainEntity: questions.map((question) => ({
      "@type": "Question",
      name: question.name,
      acceptedAnswer: {
        "@type": "Answer",
        text: question.text,
      },
    })),
  };
}

const pageUrl = new URL(Astro.url.pathname, SITE.url).href;
const breadcrumbStructuredData = buildBreadcrumbStructuredData(
  breadcrumbs,
  pageUrl
);
/**
 * Un seul balisage FAQPage sur le site, sur /infos-pratiques/ : les questions
 * ci-dessus doivent rester le décalque exact des questions affichées sur la page
 * (exigence Google : pas de contenu balisé invisible pour le visiteur).
 */
const pageStructuredData =
  pageSlug === "infos-pratiques" ? [getInfosFaqStructuredData()] : [];
const combinedStructuredData = [
  ...pageStructuredData,
  ...(breadcrumbStructuredData ? [breadcrumbStructuredData] : []),
  ...(structuredData
    ? Array.isArray(structuredData)
      ? structuredData
      : [structuredData]
    : []),
];
---

<BaseLayout
  title={seoTitle || title}
  description={seoDescription || description}
  image={image}
  lcpImage={lcpImage?.src}
  lcpImageSrcset={lcpImage?.srcset}
  lcpImageSizes="100vw"
  structuredData={combinedStructuredData}
>
  {
    pageSlug === "services" ? (
      <ServicesHero locale={locale} />
    ) : hasHero ? (
      <Hero
        title={heroTitle ?? title}
        subtitle={description ?? ""}
        backgroundImage={image!}
        backgroundImageAlt={imageAlt || title}
        backgroundPosition="bottom center"
        ctaLabel={heroCta?.label}
        ctaUrl={heroCta?.url}
        subtitleFirst={Boolean(description)}
      />
    ) : (
      <Section tone="soft" class="page-hero">
        <Container narrow>
          <Breadcrumb items={breadcrumbs} locale={locale} schema={false} />
          <h1>{title}</h1>
          {description && <p class="page-description">{description}</p>}
        </Container>
      </Section>
    )
  }

  <Container wide>
    {pageSlug === "infos-pratiques" && <InfosPratiquesJumpNav />}
    <article
      class:list={[
        "prose",
        "prose-wide",
        {
          "has-jump-nav": pageSlug === "infos-pratiques",
          "page-infos-pratiques": pageSlug === "infos-pratiques",
          "page-psychotherapie": pageSlug === "psychotherapie",
        },
      ]}
    >
      <slot />
    </article>
  </Container>

  {
    pageSlug === "services" && journalPosts.length > 0 && (
      <RelatedPostsCarousel
        posts={journalPosts}
        locale={locale}
        heading={t.services.journalTitle}
        readMoreLabel={t.blog.readMore}
        dateLocale={t.locale.date}
        prevLabel={t.blogPost.relatedPrev}
        nextLabel={t.blogPost.relatedNext}
        carouselLabel={t.services.journalCarouselLabel}
        goToSlideLabel={t.carousel.goToSlide}
      />
    )
  }

  {
    homeReviews && (
      <ReviewsBlock
        title={homeReviews.title}
        items={homeReviews.items}
        prevLabel={t.reviews.prev}
        nextLabel={t.reviews.next}
        carouselLabel={t.reviews.carouselLabel}
        goToSlideLabel={t.carousel.goToSlide}
        starsLabel={t.reviews.starsLabel}
      />
    )
  }

  {pageSlug === "infos-pratiques" && <ContactBlock legacyFormAnchor />}

  <PageIntroEnhancer />
  <PageCtaEnhancer />
  {pageSlug === "a-propos" && <AboutImageSplitEnhancer />}
  {pageSlug === "a-propos" && <ProseQuoteEnhancer />}
  {pageSlug === "infos-pratiques" && <InfosPratiquesBookingEnhancer />}
  {pageSlug === "infos-pratiques" && <InfosPratiquesCadreEnhancer />}
  {pageSlug === "infos-pratiques" && <InfosPratiquesNotesEnhancer />}
  {pageSlug === "psychotherapie" && <PsychotherapieApproachEnhancer />}
  {pageSlug === "psychotherapie" && <PsychotherapieSpecialitesEnhancer />}
  {(pageSlug === "psychotherapie" || pageSlug === "infos-pratiques") && (
    <PsychotherapieTarifEnhancer />
  )}
  {pageSlug === "services" && <ServicesHeroEnhancer />}
  {pageSlug === "services" && <ServicesIntroEnhancer />}
  {pageSlug === "services" && <ServicesSectionsEnhancer />}
  {pageSlug === "services" && <ServicesMediaEnhancer />}
  {pageSlug === "phototherapie" && <PhotoOffersEnhancer />}
  {pageSlug === "phototherapie" && <PhotoProcessEnhancer />}
  {pageSlug === "phototherapie" && <PhotoTestimonialsEnhancer />}
  <PhotoGalleryEnhancer />
</BaseLayout>

<style>
  .page-hero {
    padding-block: var(--space-xl);
    text-align: center;
  }

  .page-description {
    margin-top: var(--space-sm);
    font-size: var(--text-lg);
    color: var(--color-text-soft);
  }

  article {
    padding-block: var(--space-lg) var(--space-xl);
  }

  article.has-jump-nav {
    padding-top: var(--space-sm);
  }

  /* Aligné sur l’intro / les blocs enrichis : titres 400, corps 300 */
  :global(article.page-psychotherapie > h2) {
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-primary-dark);
  }

  :global(article.page-psychotherapie > p),
  :global(article.page-psychotherapie > ul),
  :global(article.page-psychotherapie > ol),
  :global(article.page-psychotherapie > li) {
    font-weight: 300;
  }

  /* Infos pratiques — même hiérarchie de graisses que l’intro / cadre / notes */
  :global(article.prose.page-infos-pratiques > h2) {
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-primary-dark);
  }

  :global(article.prose.page-infos-pratiques > h3) {
    font-family: var(--font-body);
    font-size: clamp(1rem, 0.9rem + 0.35vw, 1.25rem);
    font-weight: 500;
    text-transform: none;
    letter-spacing: 0.01em;
    line-height: 1.4;
    color: var(--color-primary-dark);
  }

  :global(article.prose.page-infos-pratiques > p),
  :global(article.prose.page-infos-pratiques > ul),
  :global(article.prose.page-infos-pratiques > ol),
  :global(article.prose.page-infos-pratiques > li) {
    font-weight: 300;
  }

  :global(article.prose.page-infos-pratiques > h2),
  :global(article.prose.page-infos-pratiques > h3),
  :global(article.prose.page-infos-pratiques > p) {
    max-width: 40rem;
  }

  /*
   * Rythme vertical mobile : .prose-wide > * + * (space-sm) écrase sinon
   * les marges h2 / sections et crée des « trous » irréguliers.
   */
  @media (max-width: 820px) {
    :global(article.prose.prose-wide.page-infos-pratiques > .page-intro) {
      margin-bottom: 0;
    }

    :global(article.prose.prose-wide.page-infos-pratiques > * + *) {
      margin-top: var(--space-sm);
    }

    :global(article.prose.prose-wide.page-infos-pratiques > h2),
    :global(article.prose.prose-wide.page-infos-pratiques > .infos-cadre),
    :global(article.prose.prose-wide.page-infos-pratiques > .infos-notes),
    :global(article.prose.prose-wide.page-infos-pratiques > .infos-closing),
    :global(article.prose.prose-wide.page-infos-pratiques > #cadre + .infos-cadre),
    :global(article.prose.prose-wide.page-infos-pratiques > #avant-de-consulter + .infos-notes) {
      margin-top: var(--section-y-mobile, 2rem);
    }

    :global(article.prose.prose-wide.page-infos-pratiques > #cadre),
    :global(article.prose.prose-wide.page-infos-pratiques > #avant-de-consulter) {
      margin-top: 0;
    }

    :global(article.prose.prose-wide.page-infos-pratiques > h3) {
      margin-top: var(--space-md);
    }

    :global(article.prose.prose-wide.page-infos-pratiques > h2 + h3),
    :global(article.prose.prose-wide.page-infos-pratiques > h2 + p),
    :global(article.prose.prose-wide.page-infos-pratiques > h3 + p) {
      margin-top: var(--space-sm);
    }

    :global(article.prose.prose-wide.page-infos-pratiques > h3 + p) {
      margin-top: var(--space-xs);
    }
  }
</style>
