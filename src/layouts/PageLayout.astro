---
import BaseLayout from "./BaseLayout.astro";
import ContactBlock from "@/components/sections/ContactBlock.astro";
import Container from "@/components/common/Container.astro";
import Section from "@/components/common/Section.astro";
import Hero from "@/components/sections/Hero.astro";
import ServicesHero from "@/components/sections/ServicesHero.astro";
import Breadcrumb from "@/components/common/Breadcrumb.astro";
import PhotoGalleryEnhancer from "@/components/common/PhotoGalleryEnhancer.astro";
import PageIntroEnhancer from "@/components/common/PageIntroEnhancer.astro";
import PageCtaEnhancer from "@/components/common/PageCtaEnhancer.astro";
import AboutImageSplitEnhancer from "@/components/common/AboutImageSplitEnhancer.astro";
import ProseQuoteEnhancer from "@/components/common/ProseQuoteEnhancer.astro";
import PsychotherapieApproachEnhancer from "@/components/common/PsychotherapieApproachEnhancer.astro";
import PsychotherapieSpecialitesEnhancer from "@/components/common/PsychotherapieSpecialitesEnhancer.astro";
import PsychotherapieTarifEnhancer from "@/components/common/PsychotherapieTarifEnhancer.astro";
import ServicesHeroEnhancer from "@/components/common/ServicesHeroEnhancer.astro";
import ServicesIntroEnhancer from "@/components/common/ServicesIntroEnhancer.astro";
import ServicesSectionsEnhancer from "@/components/common/ServicesSectionsEnhancer.astro";
import ServicesMediaEnhancer from "@/components/common/ServicesMediaEnhancer.astro";
import ServicesFaqEnhancer from "@/components/common/ServicesFaqEnhancer.astro";
import PhotoOffersEnhancer from "@/components/common/PhotoOffersEnhancer.astro";
import PhotoProcessEnhancer from "@/components/common/PhotoProcessEnhancer.astro";
import PhotoTestimonialsEnhancer from "@/components/common/PhotoTestimonialsEnhancer.astro";
import ReviewsBlock from "@/components/sections/ReviewsBlock.astro";
import RelatedPostsCarousel from "@/components/sections/RelatedPostsCarousel.astro";
import { getLatestPosts } from "@/lib/blog";
import { getCollection } from "astro:content";
import { SITE } from "@/site.config";
import {
  buildBreadcrumbStructuredData,
  buildBreadcrumbs,
} from "@/lib/breadcrumbs";
import { getHomeSettings } from "@/lib/settings";
import { getNavigationItems } from "@/lib/navigation";
import { getContentSlug, getLocaleFromPath } from "@/lib/i18n";
import { useTranslations } from "@/lib/translations";
import { getOptimizedImage } from "@/lib/images";
import type { StandardPageEntry } from "@/lib/pages";

interface Props {
  page: StandardPageEntry;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const { page, structuredData } = Astro.props;
const { title, heroTitle, description, image, imageAlt, seoTitle, seoDescription } = page.data;
const hasHero = Boolean(image);
const pageSlug = getContentSlug(page.filePath, page.id);
const lcpSource =
  pageSlug === "services" ? "/images/heroes/hero-services.jpg" : hasHero ? image : undefined;
const lcpImage = lcpSource
  ? await getOptimizedImage(lcpSource, {
      widths: [414, 640, 828],
      format: "webp",
      quality: 65,
    })
  : undefined;

const locale = getLocaleFromPath(Astro.url.pathname);
const heroCta =
  pageSlug === "psychotherapie" || pageSlug === "infos-pratiques"
    ? {
        label:
          locale === "fr" ? "Prendre rendez-vous en visio" : "Book a video consultation",
        url: SITE.appointmentUrl,
      }
    : null;
const t = useTranslations(locale);
const homeReviews =
  pageSlug === "infos-pratiques" ? (await getHomeSettings(locale)).reviews : null;
const journalPosts =
  pageSlug === "services"
    ? getLatestPosts(await getCollection("blog"), locale)
    : [];
const breadcrumbs = buildBreadcrumbs(
  Astro.url.pathname,
  title,
  getNavigationItems(locale),
  undefined,
  locale
);

function getServiceFaqStructuredData() {
  const questions =
    locale === "fr"
      ? [
          {
            name: "Suis-je la bonne psychologue pour vous ?",
            text: "Je vous invite à parcourir mon site et prendre le temps de sentir si mon approche peut vous convenir. Il y a tant de manières d’accompagner. Mon approche est holistique et engagée. Toutes questions pour préciser un point de ma pratique et de mon cadre thérapeutique sont bienvenues par message privé.",
          },
          {
            name: "Quelle est la régularité conseillée pour les séances ?",
            text: "Nous en discutons lors de notre première séance, mais le choix final dépendra de votre capacité à recevoir, du temps nécessaire pour intégrer chaque séance, de vos envies. Nous sommes tous différents et nous avons tous un rythme et des besoins bien différents. Nos séances s'adaptent donc à votre sensibilité.",
          },
          {
            name: "Pourquoi les séances durent 1 h 30 ?",
            text: "Il m’est important de vous offrir un espace et un temps suffisamment spacieux pour sentir, se déposer, partager. L’espace de soin est, à mon sens, un espace à protéger d’un besoin ou d’une envie de précipiter. Le corps et l’esprit ont leurs propres sagesses, comme la nature, ils vont parfois vite et parfois lentement. Ainsi, nous pouvons prendre le temps que requiert la rencontre avec votre monde intérieur.",
          },
          {
            name: "Quel espace je propose ?",
            text: "En tant que psychologue en visio, dans mon accompagnement, j'aime créer un environnement accueillant en vous offrant une écoute bienveillante et sereine. Je m'engage donc à être ressourcée, présente et disponible à vos côtés lors de chacune de nos séances. Pour cela, j'ai à cœur de prévoir des intervalles entre chaque séance que je propose. J'organise mon emploi du temps de manière à vous offrir le meilleur de ma capacité de présence et d'écoute.",
          },
        ]
      : [
          {
            name: "Am I the right psychologist for you?",
            text: "I invite you to browse my site and take the time to sense whether my approach may suit you. There are so many ways to provide support. My approach is holistic and committed. Any questions to clarify a point about my practice and therapeutic framework are welcome by private message.",
          },
          {
            name: "What is the recommended frequency for sessions?",
            text: "We discuss this during our first session, but the final choice will depend on your capacity to receive, the time needed to integrate each session, and your wishes. We are all different and we all have very different rhythms and needs. Our sessions therefore adapt to your sensitivity.",
          },
          {
            name: "Why do sessions last 1 hour 30?",
            text: "It is important to me to offer you a space and time that is sufficiently spacious to feel, settle in and share. The space of care is, in my view, a space to protect from a need or desire to rush. The body and mind have their own wisdom; like nature, they sometimes move quickly and sometimes slowly. Thus, we can take the time that meeting your inner world requires.",
          },
          {
            name: "What space do I offer?",
            text: "As an online psychologist, in my support I like to create a welcoming environment by offering you a kind and serene listening. I therefore commit to being resourced, present and available at your side during each of our sessions. For this, I make it a priority to plan intervals between each session I offer. I organise my schedule in a way that offers you the best of my capacity for presence and listening.",
          },
        ];

  return {
    "@type": "FAQPage",
    "@id": `${new URL(Astro.url.pathname, SITE.url).href}#faq`,
    mainEntity: questions.map((question) => ({
      "@type": "Question",
      name: question.name,
      acceptedAnswer: {
        "@type": "Answer",
        text: question.text,
      },
    })),
  };
}

const pageUrl = new URL(Astro.url.pathname, SITE.url).href;
const breadcrumbStructuredData = buildBreadcrumbStructuredData(
  breadcrumbs,
  pageUrl
);
/**
 * Balisage FAQPage sur /services/ : décalque des questions affichées
 * (exigence Google : pas de contenu balisé invisible pour le visiteur).
 */
const pageStructuredData =
  pageSlug === "services" ? [getServiceFaqStructuredData()] : [];
const combinedStructuredData = [
  ...pageStructuredData,
  ...(breadcrumbStructuredData ? [breadcrumbStructuredData] : []),
  ...(structuredData
    ? Array.isArray(structuredData)
      ? structuredData
      : [structuredData]
    : []),
];
---

<BaseLayout
  title={seoTitle || title}
  description={seoDescription || description}
  image={image}
  lcpImage={lcpImage?.src}
  lcpImageSrcset={lcpImage?.srcset}
  lcpImageSizes="100vw"
  structuredData={combinedStructuredData}
>
  {
    pageSlug === "services" ? (
      <ServicesHero locale={locale} />
    ) : hasHero ? (
      <Hero
        title={heroTitle ?? title}
        subtitle={description ?? ""}
        backgroundImage={image!}
        backgroundImageAlt={imageAlt || title}
        backgroundPosition="bottom center"
        ctaLabel={heroCta?.label}
        ctaUrl={heroCta?.url}
        subtitleFirst={Boolean(description)}
      />
    ) : (
      <Section tone="soft" class="page-hero">
        <Container narrow>
          <Breadcrumb items={breadcrumbs} locale={locale} schema={false} />
          <h1>{title}</h1>
          {description && <p class="page-description">{description}</p>}
        </Container>
      </Section>
    )
  }

  <Container wide>
    <article
      class:list={[
        "prose",
        "prose-wide",
        {
          "page-psychotherapie": pageSlug === "psychotherapie",
        },
      ]}
    >
      <slot />
    </article>
  </Container>

  {
    pageSlug === "services" && journalPosts.length > 0 && (
      <RelatedPostsCarousel
        posts={journalPosts}
        locale={locale}
        heading={t.services.journalTitle}
        readMoreLabel={t.blog.readMore}
        dateLocale={t.locale.date}
        prevLabel={t.blogPost.relatedPrev}
        nextLabel={t.blogPost.relatedNext}
        carouselLabel={t.services.journalCarouselLabel}
        goToSlideLabel={t.carousel.goToSlide}
      />
    )
  }

  {
    homeReviews && (
      <ReviewsBlock
        title={homeReviews.title}
        items={homeReviews.items}
        prevLabel={t.reviews.prev}
        nextLabel={t.reviews.next}
        carouselLabel={t.reviews.carouselLabel}
        goToSlideLabel={t.carousel.goToSlide}
        starsLabel={t.reviews.starsLabel}
      />
    )
  }

  {pageSlug === "infos-pratiques" && <ContactBlock legacyFormAnchor />}

  <PageIntroEnhancer />
  <PageCtaEnhancer />
  {pageSlug === "a-propos" && <AboutImageSplitEnhancer />}
  {pageSlug === "a-propos" && <ProseQuoteEnhancer />}
  {pageSlug === "psychotherapie" && <PsychotherapieApproachEnhancer />}
  {pageSlug === "psychotherapie" && <PsychotherapieSpecialitesEnhancer />}
  {pageSlug === "psychotherapie" && <PsychotherapieTarifEnhancer />}
  {pageSlug === "services" && <ServicesHeroEnhancer />}
  {pageSlug === "services" && <ServicesIntroEnhancer />}
  {pageSlug === "services" && <ServicesSectionsEnhancer />}
  {pageSlug === "services" && <ServicesMediaEnhancer />}
  {pageSlug === "services" && <ServicesFaqEnhancer />}
  {pageSlug === "phototherapie" && <PhotoOffersEnhancer />}
  {pageSlug === "phototherapie" && <PhotoProcessEnhancer />}
  {pageSlug === "phototherapie" && <PhotoTestimonialsEnhancer />}
  <PhotoGalleryEnhancer />
</BaseLayout>

<style>
  .page-hero {
    padding-block: var(--space-xl);
    text-align: center;
  }

  .page-description {
    margin-top: var(--space-sm);
    font-size: var(--text-lg);
    color: var(--color-text-soft);
  }

  article {
    padding-block: var(--space-lg) var(--space-xl);
  }

  /* Aligné sur l’intro / les blocs enrichis : titres 400, corps 300 */
  :global(article.page-psychotherapie > h2) {
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-primary-dark);
  }

  :global(article.page-psychotherapie > p),
  :global(article.page-psychotherapie > ul),
  :global(article.page-psychotherapie > ol),
  :global(article.page-psychotherapie > li) {
    font-weight: 300;
  }
</style>
